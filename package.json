  "keywords": [
    "three",
    "threejs",
    "vfx",
    "particles",
    "niagara",
    "gpu",
    "webgpu",
    "tsl",
    "compute",
    "shader"
  ],
  "homepage": "https://github.com/travisdmathis/plume#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travisdmathis/plume.git",
    "directory": "packages/plume"
  },
  "bugs": {
    "url": "https://github.com/travisdmathis/plume/issues"
  },
  "license": "MIT",
  "author": "Travis Mathis",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
